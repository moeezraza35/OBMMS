# ---------- Stage 1: build the Vite bundle ----------
FROM node:22-slim AS build

WORKDIR /app/frontend

COPY package*.json ./
RUN npm ci

COPY ./eslint.config.js ./
COPY ./index.html ./
COPY ./vite.config.js ./
COPY ./public ./public
COPY ./src ./src

RUN npm run build

# ---------- Stage 2: arrange output as templates/ + static/ ----------
FROM alpine:3.20 AS artifacts

WORKDIR /app

RUN mkdir -p /app/templates /app/static

COPY --from=build /app/frontend/dist ./dist

RUN mv /app/dist/index.html /app/templates/index.html && \
    find /app/dist -mindepth 1 -maxdepth 1 -exec mv {} /app/static/ \; && \
    rmdir /app/dist