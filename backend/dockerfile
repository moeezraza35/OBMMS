FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade -r requirements.txt

COPY ./accounts /app/OBMMS/accounts
COPY ./admin /app/OBMMS/admin
COPY ./auth /app/OBMMS/auth
COPY ./obmms /app/OBMMS/obmms
COPY ./tracking /app/OBMMS/tracking
COPY ./main.py /app/OBMMS/main.py

EXPOSE 8000

CMD ["python", "main.py", "runserver"]